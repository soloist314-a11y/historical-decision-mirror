{
  "baseline_origin": "v0.8 retained 18-case set",
  "tests": [
    {
      "test_id": "V5-V5-T1",
      "query": "两个核心成员发生同级冲突，但外部有共同威胁，我是否应先降级内部冲突",
      "expected_top3_any": [
        "HD-049"
      ]
    },
    {
      "test_id": "V5-V5-T2",
      "query": "强势股东要求违规例外，规则执行者是否应该坚持制度并解释共同利益",
      "expected_top3_any": [
        "HD-050"
      ]
    },
    {
      "test_id": "V5-V5-T3",
      "query": "一个候选人名气很大，但任命前有多个独立意见和具体反证警告我不要换人",
      "expected_top3_any": [
        "HD-051"
      ]
    },
    {
      "test_id": "V5-V5-T4",
      "query": "我被重新请回负责结果，但如果没有策略自主权和明确授权边界就不应接任",
      "expected_top3_any": [
        "HD-053"
      ]
    },
    {
      "test_id": "V5-V5-T5",
      "query": "重大人才决定只有一个信息源，而这个报告人可能被收买，我是否要交叉核验",
      "expected_top3_any": [
        "HD-052"
      ]
    },
    {
      "test_id": "V5-V5-T6",
      "query": "一个真实坏事件之后，组织想一刀切全面清退一类人，是否应纠偏政策",
      "expected_top3_any": [
        "HD-054"
      ]
    },
    {
      "test_id": "V5-V5-T7",
      "query": "名义上我有权，但合作方已经事实控制关键资源且我无法强制，是否承认既成事实换合作",
      "expected_top3_any": [
        "HD-055"
      ]
    },
    {
      "test_id": "V5-V5-T8",
      "query": "团队不敢说坏消息，有人尖锐直言让我生气，我应如何保留真实反馈通道",
      "expected_top3_any": [
        "HD-058"
      ]
    },
    {
      "test_id": "V5-V5-T9",
      "query": "有人通过攻击威胁逼我撤掉关键负责人，如果换人会不会形成奖励威胁的信号",
      "expected_top3_any": [
        "HD-060"
      ]
    },
    {
      "test_id": "V5-V5-T10",
      "query": "合作对象刚脱离旧体系，窗口期很短，我是否应该立即任命并快速确认正式身份",
      "expected_top3_any": [
        "HD-059"
      ]
    },
    {
      "test_id": "V5-V5-T11",
      "query": "两个重要合作方互相要求我站队，我想保持对称中立和一致边界",
      "expected_top3_any": [
        "HD-057"
      ]
    },
    {
      "test_id": "V4-T1_platform_autonomy",
      "query": "一个主体拥有稀缺的客户与项目获取能力，但强平台掌握正式履约体系和控制权。继续留在平台可以获得短期资源，却会增加依赖和沉没成本；另一条路是自建能力，短期资源较弱，但可提高自主权、退出能力和未来选择权。",
      "expected_top3_any": [
        "HD-013"
      ]
    },
    {
      "test_id": "V4-T2_reversible_delivery",
      "query": "强势合作方要求我方先交付不可替代的核心资产，但对方后续承诺缺乏可强制执行的保证。一旦先交付，我方会失去议价权和退出能力；希望设计可逆交付和违约责任。",
      "expected_top3_any": [
        "HD-010"
      ]
    },
    {
      "test_id": "V4-T3_succession_dual_authority",
      "query": "一个组织已经完成名义交班，但原负责人仍掌握威望、关键资源和实际影响力，又试图在继承人之间重新分配权力。需要判断双重权威、接班边界和长期治理风险。",
      "expected_top3_any": [
        "HD-033"
      ]
    },
    {
      "test_id": "V4-T4_reward_vs_role",
      "query": "一个人功劳很大，需要给予足够奖励，但不确定他是否适合更高管理岗位。问题是应把功劳奖励和岗位授权合并，还是把爵赏与实际管理权拆开。",
      "expected_top3_any": [
        "HD-022"
      ]
    },
    {
      "test_id": "V4-T5_strategic_concession",
      "query": "对方实力强于我，而且不断提出超出原约定的新要求。现在单独拒绝可能立刻引发冲突，但其他参与方也可能成为下一轮被索取对象。我考虑是否暂时让步购买时间，让共同威胁暴露后再联合其他受压方。",
      "expected_top3_any": [
        "HD-045"
      ]
    },
    {
      "test_id": "V4-T6_post_failure_wait",
      "query": "团队刚经历一次重大失败，士气偏低，对手因为刚赢而不断挑衅。我不想为了证明自己马上再战，而想等待对方疲惫、补给恶化或内部离心等触发条件出现后再行动。",
      "expected_top3_any": [
        "HD-048"
      ]
    },
    {
      "test_id": "V4-T7_delegation_control",
      "query": "我暂时不在现场，把执行权授权给下属。既定策略是等待，不要被对方挑衅诱导，但代理人担心显得软弱，可能擅自改变策略。如何看这种授权给下属后的执行失控风险？",
      "expected_top3_any": [
        "HD-047"
      ]
    }
  ]
}
